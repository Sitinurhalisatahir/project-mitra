<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 600" width="100%" height="100%" fill="none">
  <defs>
    <linearGradient id="tBgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#F8FAFC"/>
      <stop offset="50%" stop-color="#EEF2FF"/>
      <stop offset="100%" stop-color="#E0E7FF"/>
    </linearGradient>
    <linearGradient id="tPrimary" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#4F46E5"/>
      <stop offset="100%" stop-color="#3730A3"/>
    </linearGradient>
    <linearGradient id="tSecondary" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#F59E0B"/>
      <stop offset="100%" stop-color="#D97706"/>
    </linearGradient>
    <linearGradient id="tEmerald" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#10B981"/>
      <stop offset="100%" stop-color="#047857"/>
    </linearGradient>
    <filter id="tShadow" x="-10%" y="-10%" width="120%" height="125%" filterUnits="userSpaceOnUse">
      <feDropShadow dx="0" dy="12" stdDeviation="16" flood-color="#4F46E5" flood-opacity="0.1"/>
    </filter>
  </defs>

  <rect width="600" height="600" rx="36" fill="url(#tBgGrad)"/>

  <!-- Background decorative concentric rings -->
  <circle cx="300" cy="300" r="230" stroke="#E2E8F0" stroke-width="1.5" stroke-dasharray="6 6"/>
  <circle cx="300" cy="300" r="160" stroke="#C7D2FE" stroke-width="2"/>
  <circle cx="300" cy="300" r="90" fill="#EEF2FF"/>

  <!-- Center Hub: SkillMatch Core -->
  <g filter="url(#tShadow)">
    <circle cx="300" cy="300" r="62" fill="url(#tPrimary)"/>
    <circle cx="300" cy="300" r="48" fill="#4338CA"/>
    <!-- Hub Icon -->
    <path d="M 300 280 L 316 292 L 316 312 L 300 322 L 284 312 L 284 292 Z" stroke="#FFFFFF" stroke-width="2.5" fill="none"/>
    <circle cx="300" cy="301" r="5" fill="#F59E0B"/>
    <line x1="300" y1="280" x2="300" y2="296" stroke="#FFFFFF" stroke-width="2"/>
    <line x1="316" y1="312" x2="304" y2="304" stroke="#FFFFFF" stroke-width="2"/>
    <line x1="284" y1="312" x2="296" y2="304" stroke="#FFFFFF" stroke-width="2"/>
  </g>

  <!-- Connecting Lines from Central Hub to Satellite Nodes -->
  <line x1="300" y1="238" x2="300" y2="150" stroke="#4F46E5" stroke-width="3" stroke-linecap="round"/>
  <line x1="344" y1="266" x2="430" y2="200" stroke="#F59E0B" stroke-width="3" stroke-linecap="round"/>
  <line x1="354" y1="324" x2="440" y2="380" stroke="#10B981" stroke-width="3" stroke-linecap="round"/>
  <line x1="256" y1="334" x2="170" y2="380" stroke="#6366F1" stroke-width="3" stroke-linecap="round"/>
  <line x1="246" y1="276" x2="170" y2="200" stroke="#EC4899" stroke-width="3" stroke-linecap="round"/>

  <!-- Satellite Node 1: Keahlian Spesifik (Top) -->
  <g filter="url(#tShadow)">
    <rect x="210" y="80" width="180" height="70" rx="20" fill="#FFFFFF" stroke="#E2E8F0"/>
    <circle cx="245" cy="115" r="20" fill="#EEF2FF"/>
    <path d="M 238 115 L 243 120 L 252 110" stroke="#4F46E5" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
    <text x="274" y="110" font-family="'Plus Jakarta Sans', sans-serif" font-size="12" font-weight="800" fill="#0F172A">Keahlian Spesifik</text>
    <text x="274" y="126" font-family="'Plus Jakarta Sans', sans-serif" font-size="10" font-weight="600" fill="#64748B">Sesuai Kebutuhan</text>
  </g>

  <!-- Satellite Node 2: Minat & Visi (Top Right) -->
  <g filter="url(#tShadow)">
    <rect x="370" y="160" width="170" height="68" rx="20" fill="#FFFFFF" stroke="#E2E8F0"/>
    <circle cx="400" cy="194" r="18" fill="#FEF3C7"/>
    <circle cx="400" cy="194" r="8" fill="#D97706"/>
    <text x="428" y="190" font-family="'Plus Jakarta Sans', sans-serif" font-size="12" font-weight="800" fill="#0F172A">Minat &amp; Visi</text>
    <text x="428" y="206" font-family="'Plus Jakarta Sans', sans-serif" font-size="10" font-weight="600" fill="#D97706">Satu Visi Proyek</text>
  </g>

  <!-- Satellite Node 3: Waktu Terukur (Bottom Right) -->
  <g filter="url(#tShadow)">
    <rect x="370" y="370" width="170" height="68" rx="20" fill="#FFFFFF" stroke="#E2E8F0"/>
    <circle cx="400" cy="404" r="18" fill="#DCFCE7"/>
    <circle cx="400" cy="404" r="8" stroke="#10B981" stroke-width="2"/>
    <line x1="400" y1="400" x2="400" y2="404" stroke="#10B981" stroke-width="2"/>
    <line x1="400" y1="404" x2="404" y2="404" stroke="#10B981" stroke-width="2"/>
    <text x="428" y="400" font-family="'Plus Jakarta Sans', sans-serif" font-size="12" font-weight="800" fill="#0F172A">Waktu Sinkron</text>
    <text x="428" y="416" font-family="'Plus Jakarta Sans', sans-serif" font-size="10" font-weight="600" fill="#15803D">Komitmen Jelas</text>
  </g>

  <!-- Satellite Node 4: Chat Efisien (Bottom Left) -->
  <g filter="url(#tShadow)">
    <rect x="60" y="370" width="180" height="68" rx="20" fill="#FFFFFF" stroke="#E2E8F0"/>
    <circle cx="95" cy="404" r="18" fill="#EEF2FF"/>
    <rect x="88" y="398" width="14" height="10" rx="2" stroke="#4F46E5" stroke-width="2"/>
    <text x="122" y="400" font-family="'Plus Jakarta Sans', sans-serif" font-size="12" font-weight="800" fill="#0F172A">Bebas Spam Chat</text>
    <text x="122" y="416" font-family="'Plus Jakarta Sans', sans-serif" font-size="10" font-weight="600" fill="#4F46E5">Diskusi Langsung</text>
  </g>

  <!-- Satellite Node 5: Kolaborasi Mahasiswa (Top Left) -->
  <g filter="url(#tShadow)">
    <rect x="60" y="160" width="180" height="68" rx="20" fill="#FFFFFF" stroke="#E2E8F0"/>
    <circle cx="95" cy="194" r="18" fill="#FCE7F3"/>
    <circle cx="95" cy="190" r="6" fill="#DB2777"/>
    <path d="M 87 203 Q 95 198 103 203" fill="#DB2777"/>
    <text x="122" y="190" font-family="'Plus Jakarta Sans', sans-serif" font-size="12" font-weight="800" fill="#0F172A">Lintas Jurusan</text>
    <text x="122" y="206" font-family="'Plus Jakarta Sans', sans-serif" font-size="10" font-weight="600" fill="#BE185D">Kampus Berdaya</text>
  </g>

  <!-- Floating Success Bubble -->
  <g filter="url(#tShadow)">
    <rect x="200" y="480" width="200" height="48" rx="24" fill="#0F172A"/>
    <circle cx="224" cy="504" r="12" fill="#10B981"/>
    <path d="M 220 504 L 223 507 L 229 501" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round"/>
    <text x="246" y="508" font-family="'Plus Jakarta Sans', sans-serif" font-size="11" font-weight="700" fill="#FFFFFF">
      Tim Solid Terbentuk!
    </text>
  </g>
</svg>
